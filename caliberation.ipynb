# ── UTILS ─────────────────────────────────────────────────────────────────────
def _rename_to_standard(df: pd.DataFrame) -> pd.DataFrame:
    """Normalize columns to y_true, y_score, patient_id if present."""
    col_map = {}
    for c in df.columns:
        cl = c.lower().strip()
        if cl in ["y_true", "label", "labels", "target", "gt", "truth"]:
            col_map[c] = "y_true"
        if cl in ["y_score", "score", "pred", "prob", "proba", "p"]:
            col_map[c] = "y_score"
        if cl in ["patient_id", "patient", "pid", "case_id", "subject_id"]:
            col_map[c] = "patient_id"
    return df.rename(columns=col_map)

def ensure_patient_level(df: pd.DataFrame) -> pd.DataFrame:
    """
    If patient_id exists and multiple rows per patient, aggregate max-over-views:
      y_score = max, y_true = max (safety)
    """
    if "patient_id" not in df.columns:
        return df
    n_rows = len(df)
    n_pts  = df["patient_id"].nunique()
    if n_pts < n_rows:
        g = df.groupby("patient_id", as_index=False).agg(
            y_score=("y_score", "max"),
            y_true=("y_true", "max"),
        )
        return g
    return df

def bootstrap_ci(values, lo=2.5, hi=97.5):
    values = np.asarray(values, dtype=float)
    return float(np.percentile(values, lo)), float(np.percentile(values, hi))

def bootstrap_brier(y_true, y_score, n_boot=500, seed=42):
    """Bootstrap 95% CI for Brier score."""
    rng = np.random.default_rng(seed)
    scores = []
    y_true = np.asarray(y_true).astype(int)
    y_score = np.asarray(y_score).astype(float)
    n = len(y_true)
    for _ in range(n_boot):
        idx = rng.integers(0, n, n)
        yt, ys = y_true[idx], y_score[idx]
        # skip degenerate resamples
        if yt.sum() == 0 or yt.sum() == len(yt):
            continue
        scores.append(brier_score_loss(yt, ys))
    if len(scores) == 0:
        return (np.nan, np.nan)
    return bootstrap_ci(scores)

def ece_uniform_bins(y_true, y_score, n_bins=10):
    """
    Standard ECE with uniform bins, weighted by bin frequency:
      ECE = sum_b (n_b/n) * |acc_b - conf_b|
    """
    y_true  = np.asarray(y_true).astype(int)
    y_score = np.asarray(y_score).astype(float)

    edges = np.linspace(0.0, 1.0, n_bins + 1)
    bin_id = np.digitize(y_score, edges) - 1
    bin_id = np.clip(bin_id, 0, n_bins - 1)

    n = len(y_true)
    ece = 0.0
    for b in range(n_bins):
        m = (bin_id == b)
        nb = int(m.sum())
        if nb == 0:
            continue
        acc  = float(y_true[m].mean())
        conf = float(y_score[m].mean())
        ece += (nb / n) * abs(acc - conf)
    return float(ece)

def binned_accuracy_fixed(y_true, y_score, edges):
    """
    Returns acc per fixed bin (NaN where empty).
    """
    y_true  = np.asarray(y_true).astype(int)
    y_score = np.asarray(y_score).astype(float)

    n_bins = len(edges) - 1
    bin_id = np.digitize(y_score, edges) - 1
    bin_id = np.clip(bin_id, 0, n_bins - 1)

    acc = np.full(n_bins, np.nan, dtype=float)
    for b in range(n_bins):
        m = (bin_id == b)
        if m.sum() > 0:
            acc[b] = float(y_true[m].mean())
    return acc

def net_benefit(y_true, y_score, thresholds):
    """
    Net benefit at each probability threshold pt:
      NB(pt) = TP/n - (pt/(1-pt)) * FP/n
    """
    y_true  = np.asarray(y_true).astype(int)
    y_score = np.asarray(y_score).astype(float)
    n = len(y_true)

    nb = np.zeros(len(thresholds), dtype=float)
    for i, pt in enumerate(thresholds):
        pred = (y_score >= pt).astype(int)
        tp = ((pred == 1) & (y_true == 1)).sum()
        fp = ((pred == 1) & (y_true == 0)).sum()
        nb[i] = (tp / n) - (pt / (1 - pt + 1e-9)) * (fp / n)
    return nb

def treat_all_nb(y_true, thresholds):
    prev = float(np.mean(y_true))
    nb = np.zeros(len(thresholds), dtype=float)
    for i, pt in enumerate(thresholds):
        nb[i] = prev - (pt / (1 - pt + 1e-9)) * (1 - prev)
    return nb

# ── 1) LOAD PREDICTION CSVs ──────────────────────────────────────────────────
print("=" * 70)
print("Loading NB03 prediction CSVs")
print("=" * 70)

scenarios = {}
for sid in SCENARIO_IDS:
    csv_path = LOG_DIR / f"nb03_{sid}_pred_{NB03_CFG_HASH}.csv"
    if not csv_path.exists():
        raise FileNotFoundError(
            f"CSV not found: {csv_path}\n"
            f"Expected NB03 saved per-patient prediction CSVs with y_true/y_score.\n"
        )

    df = pd.read_csv(csv_path)
    df = _rename_to_standard(df)

    if "y_true" not in df.columns or "y_score" not in df.columns:
        raise KeyError(
            f"Missing y_true/y_score in {csv_path.name}. "
            f"Columns: {df.columns.tolist()}"
        )

    # enforce types + clamp probs into [0,1] just in case
    df["y_true"] = df["y_true"].astype(int)
    df["y_score"] = df["y_score"].astype(float).clip(0.0, 1.0)

    # sanity & optional aggregation
    if "patient_id" in df.columns:
        n_rows = len(df)
        n_pts = df["patient_id"].nunique()
        print(f"  {sid}: rows={n_rows}, unique_patients={n_pts}")
    df = ensure_patient_level(df)

    key = sid.split("_")[0]  # S1, S2, S3

    y_true = df["y_true"].values
    y_score = df["y_score"].values

    n, pos = len(df), int(df["y_true"].sum())
    auroc = roc_auc_score(y_true, y_score)
    print(f"  {key}: N={n}, Pos={pos} ({pos/n*100:.1f}%), AUROC={auroc:.4f}")

    scenarios[key] = {
        "y_true": y_true,
        "y_score": y_score,
        "label": SCENARIO_LABELS[key],
    }

print()

# ── 2) BRIER SCORES + ECE (proper) WITH 95% CI ───────────────────────────────
print("=" * 70)
print("Brier Scores + ECE (proper, weighted)")
print("=" * 70)

brier_results = {}
ece_results = {}

for key, s in scenarios.items():
    y_true, y_score = s["y_true"], s["y_score"]

    bs = float(brier_score_loss(y_true, y_score))
    ci_lo, ci_hi = bootstrap_brier(y_true, y_score, BOOTSTRAP_N, SEED)

    ece = ece_uniform_bins(y_true, y_score, N_BINS)

    brier_results[key] = {"brier": bs, "ci_lo": ci_lo, "ci_hi": ci_hi}
    ece_results[key] = {"ece": ece}

    print(f"  {key} {s['label']}: Brier={bs:.4f} (95% CI: {ci_lo:.4f}–{ci_hi:.4f}), ECE={ece:.4f}")

# Brier skill vs prevalence-only predictor
for key, s in scenarios.items():
    prev = float(np.mean(s["y_true"]))
    null_brier = prev * (1 - prev)
    skill = 1 - (brier_results[key]["brier"] / (null_brier + 1e-12))
    print(f"  {key} Brier Skill Score (vs prevalence-only): {skill:.3f}")

print()

# ── 3) PANEL C — RELIABILITY DIAGRAMS (with valid bootstrap band) ────────────
print("=" * 70)
print("Reliability Diagrams (Calibration Curves)")
print("=" * 70)

bin_edges = np.linspace(0, 1, N_BINS + 1)
bin_centers = (bin_edges[:-1] + bin_edges[1:]) / 2

fig_c, axes_c = plt.subplots(1, 3, figsize=(7.0, 2.5), dpi=SAVE_DPI)
# Nature-like panel label: bold letter only
fig_c.text(0.01, 0.98, "C", fontsize=9, fontweight="bold", va="top", ha="left")

for ax, key in zip(axes_c, ["S1", "S2", "S3"]):
    s = scenarios[key]
    y_true, y_score = s["y_true"], s["y_score"]
    color = COLORS[key]

    # Main curve via sklearn (ok for line)
    frac_pos, mean_pred = calibration_curve(y_true, y_score, n_bins=N_BINS, strategy="uniform")

    # Bootstrap band (VALID): fixed bins -> acc per bin plotted against bin centers
    rng = np.random.default_rng(SEED)
    boot_acc = []
    n = len(y_true)
    for _ in range(BOOTSTRAP_N):
        idx = rng.integers(0, n, n)
        yt, ys = y_true[idx], y_score[idx]
        # skip degenerate
        if yt.sum() == 0 or yt.sum() == len(yt):
            continue
        acc = binned_accuracy_fixed(yt, ys, bin_edges)
        boot_acc.append(acc)

    if len(boot_acc) > 0:
        boot_arr = np.array(boot_acc)  # (B, bins)
        ci_lo = np.nanpercentile(boot_arr, 2.5, axis=0)
        ci_hi = np.nanpercentile(boot_arr, 97.5, axis=0)

        # fill band only where finite
        finite = np.isfinite(ci_lo) & np.isfinite(ci_hi)
        ax.fill_between(bin_centers[finite], ci_lo[finite], ci_hi[finite],
                        alpha=0.18, color=color, linewidth=0)

    # Perfect line
    ax.plot([0, 1], [0, 1], "--", color=COLORS["ref"], linewidth=0.8, label="Perfect")

    # Main curve
    ax.plot(mean_pred, frac_pos, "o-", color=color, markersize=4,
            linewidth=1.0, label=s["label"])

    # Annotations (ECE + Brier)
    ece_val = ece_results[key]["ece"]
    bs_val = brier_results[key]["brier"]
    ax.text(0.05, 0.92, f"ECE={ece_val:.3f}\nBrier={bs_val:.3f}",
            transform=ax.transAxes, fontsize=6.5, va="top",
            bbox=dict(boxstyle="round,pad=0.3", facecolor="white", edgecolor="0.8", linewidth=0.5))

    ax.set_xlim(0, 1)
    ax.set_ylim(0, 1.02)
    ax.set_xlabel("Mean predicted probability")
    ax.set_ylabel("Fraction positive" if key == "S1" else "")
    ax.set_title(s["label"], fontsize=8)
    ax.set_aspect("equal")
    ax.tick_params(length=3)

fig_c.tight_layout(rect=[0, 0, 1, 0.95])
out_c = PAPER_FIGS / "Supp_Fig_S3_PanelC_Calibration.png"
fig_c.savefig(out_c, dpi=SAVE_DPI)
plt.close(fig_c)
print(f"  Saved: {out_c}")

# ── 4) PANEL D — DECISION CURVE ANALYSIS (DCA) ───────────────────────────────
print("=" * 70)
print("Decision Curve Analysis (DCA)")
print("=" * 70)

# Threshold range (kept as you had; can be justified as broad operating region)
thresholds = np.linspace(0.01, 0.50, 200)

fig_d, axes_d = plt.subplots(1, 3, figsize=(7.0, 2.5), dpi=SAVE_DPI, sharey=False)
fig_d.text(0.01, 0.98, "D", fontsize=9, fontweight="bold", va="top", ha="left")

for ax, key in zip(axes_d, ["S1", "S2", "S3"]):
    s = scenarios[key]
    y_true, y_score = s["y_true"], s["y_score"]
    color = COLORS[key]

    nb_model = net_benefit(y_true, y_score, thresholds)
    nb_all   = treat_all_nb(y_true, thresholds)
    nb_none  = np.zeros_like(thresholds)

    ax.plot(thresholds, nb_model, color=color, linewidth=1.2, label="Model")
    ax.plot(thresholds, nb_all, color="black", linewidth=0.8, linestyle="--", label="Treat all")
    ax.plot(thresholds, nb_none, color=COLORS["ref"], linewidth=0.8, linestyle=":", label="Treat none")

    better = (nb_model > nb_all) & (nb_model > nb_none)
    if np.any(better):
        ax.fill_between(thresholds, nb_none, nb_model, where=better, alpha=0.15, color=color)

    # y limits
    y_min = max(-0.05, float(nb_all.min()) - 0.02)
    y_max = max(float(nb_model.max()), float(nb_all.max())) + 0.02
    ax.set_ylim(y_min, y_max)
    ax.set_xlim(thresholds[0], thresholds[-1])

    ax.set_xlabel("Threshold probability")
    ax.set_ylabel("Net benefit" if key == "S1" else "")
    ax.set_title(s["label"], fontsize=8)
    ax.tick_params(length=3)
    if key == "S1":
        ax.legend(loc="upper right", fontsize=6, frameon=True)
    ax.axhline(0, color="black", linewidth=0.4, linestyle="-")

fig_d.tight_layout(rect=[0, 0, 1, 0.95])
out_d = PAPER_FIGS / "Supp_Fig_S3_PanelD_DCA.png"
fig_d.savefig(out_d, dpi=SAVE_DPI)
plt.close(fig_d)
print(f"  Saved: {out_d}")

